# Helen服装批发管理系统 - 环境变量示例
# 复制此文件为 .env.local 并填入实际值

# 服务端口（默认 5000）
DEPLOY_RUN_PORT=5000

# 项目工作目录
COZE_WORKSPACE_PATH=/workspace/projects

# 对外访问域名
COZE_PROJECT_DOMAIN_DEFAULT=localhost:5000

# 运行环境: DEV 或 PROD
COZE_PROJECT_ENV=DEV

# Supabase（跨设备数据持久化必需，仅在服务端配置）
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key

# 推荐配置。API 路由使用此密钥绕过 RLS；严禁添加 NEXT_PUBLIC_ 前缀。
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
